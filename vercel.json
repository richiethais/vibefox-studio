{
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/client/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/join",
      "destination": "/spa.html"
    },
    {
      "source": "/reset-password",
      "destination": "/spa.html"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ]
}
